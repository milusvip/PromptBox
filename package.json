{
  "name": "promptbox",
  "version": "1.0.0",
  "description": "PromptBox - Claude Code 提示词管理器",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist out",
    "build:installer": "electron-vite build && rimraf dist && electron-builder --win --config",
    "build:portable": "electron-vite build && rimraf dist && electron-builder --win portable --config"
  },
  "keywords": [
    "claude-code",
    "prompt",
    "manager"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.14",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.promptbox.app",
    "productName": "PromptBox",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "milusvip",
      "repo": "PromptBox"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": "PromptBox"
    }
  }
}
